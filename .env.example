# Required: who gets paid. Refuses to start without this.
PAY_TO=0xYourSettlementAddress

# Settlement chain. "mainnet" = bridged USDC.e (6 decimals), "testnet" = pieUSD (18).
KITE_NETWORK=mainnet

# Facilitator endpoint. The default serves both networks.
FACILITATOR_URL=https://facilitator.pieverse.io/v2

# HTTP server
PORT=8787

# How long to keep an identical upstream response. 0 disables caching.
# The public open-meteo API is free but rate-limited; a little caching goes a
# long way when several callers ask for the same city.
CACHE_TTL_SECONDS=45

# Give up on the upstream after this long.
UPSTREAM_TIMEOUT_MS=4000

# Per-route price overrides. Prices are USD and converted to atomic units of
# the settlement asset at request time. Omit a line to use the default.
# PRICE_FORECAST=0.002
# PRICE_AIR_QUALITY=0.001
# PRICE_CLIMATE=0.01
