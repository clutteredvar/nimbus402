{
  "name": "nimbus402",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Weather data over HTTP, billed per call on Kite Chain.",
  "keywords": [
    "x402",
    "kite",
    "payments",
    "weather",
    "hono"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@x402/core": "^2.25.0",
    "@x402/evm": "^2.25.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
